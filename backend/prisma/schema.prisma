generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  price     Float
  stock     Int
  createdAt DateTime @default(now())
  category  String
}
